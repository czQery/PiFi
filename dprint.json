{
	"typescript": {
		"useBraces": "whenNotSingleLine",
		"bracePosition": "maintain",
		"preferSingleLine": true,
		"quoteStyle": "alwaysDouble",
		"quoteProps": "consistent",
		"operatorPosition": "nextLine",
		"jsx.bracketPosition": "nextLine",
		"arrowFunction.useParentheses": "preferNone",
		"importDeclaration.forceSingleLine": true,
		"exportDeclaration.forceSingleLine": true,
		"commentLine.forceSpaceAfterSlashes": true,
		"binaryExpression.spaceSurroundingBitwiseAndArithmeticOperator": true,
		"semiColons": "asi"
	},
	"json": {},
	"markdown": {},
	"toml": {},
	"biome": {
		"css.enabled": false,
		"graphql.enabled": false,
		"semicolons": "asNeeded",
		"bracketSameLine": true
	},
	"malva": {},
	"markup": {},
	"yaml": {},
	"exec": {
		"cwd": "${configDir}",
		"commands": [
			{
				"command": "gofmt {{file_path}}",
				"exts": ["go"]
			}
		]
	},
	"lineWidth": 160,
	"indentWidth": 4,
	"useTabs": true,
	"excludes": ["*.svg", "**/node_modules", "**/*-lock.json"],
	"plugins": [
		"https://plugins.dprint.dev/typescript-0.95.15.wasm",
		"https://plugins.dprint.dev/json-0.21.1.wasm",
		"https://plugins.dprint.dev/markdown-0.21.1.wasm",
		"https://plugins.dprint.dev/toml-0.7.0.wasm",
		"https://plugins.dprint.dev/biome-0.11.13.wasm",
		"https://plugins.dprint.dev/g-plane/malva-v0.15.2.wasm",
		"https://plugins.dprint.dev/g-plane/markup_fmt-v0.25.3.wasm",
		"https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
		"https://plugins.dprint.dev/exec-0.6.0.json@a054130d458f124f9b5c91484833828950723a5af3f8ff2bd1523bd47b83b364"
	]
}
